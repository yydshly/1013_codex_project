  "tasks": [
    {"id": "research-a", "role": "项目 A 研究", "depends_on": [], "input": {"source_url": "填写真实源库 URL", "source_ref": "填写固定 commit 或 tag"}, "output_directory": "results/research-a/", "required_fields": ["capabilities", "mechanism", "source_evidence", "experiment_results", "unverified", "license"]},
    {"id": "research-b", "role": "项目 B 研究", "depends_on": [], "input": {"source_url": "填写真实源库 URL", "source_ref": "填写固定 commit 或 tag"}, "output_directory": "results/research-b/", "required_fields": ["capabilities", "mechanism", "source_evidence", "experiment_results", "unverified", "license"]},
    {"id": "research-c", "role": "项目 C 研究", "depends_on": [], "input": {"source_url": "填写真实源库 URL", "source_ref": "填写固定 commit 或 tag"}, "output_directory": "results/research-c/", "required_fields": ["capabilities", "mechanism", "source_evidence", "experiment_results", "unverified", "license"]},
