# Copy this file to .env beside server.py. Environment variables take precedence.
# Use your provider's OpenAI-compatible base URL, normally ending in /v1.
BOOKSHELF_BASE_URL=https://your-model-service.example/v1
BOOKSHELF_MODEL=your-model-id
# Optional: leave empty for unauthenticated local services.
BOOKSHELF_API_KEY=

# Alternatively leave BOOKSHELF_API_KEY empty and use an existing local key variable:
# BOOKSHELF_API_KEY_ENV=YOUR_EXISTING_KEY_VARIABLE

# Bound the cost and waiting time of each chapter; not a whole-book word target.
BOOKSHELF_SECTION_MAX_TOKENS=800
BOOKSHELF_TIMEOUT_SECONDS=90
