# Copy to .env. Supply your own endpoint and model ID. Keep credentials local.
# Base URL usually ends in /v1; /chat/completions is appended automatically.
AUDIT_LLM_BASE_URL=
AUDIT_LLM_MODEL=
AUDIT_LLM_API_KEY=

# json_schema, json_object, or text. No automatic fallback or paid retries.
AUDIT_LLM_RESPONSE_MODE=json_schema
AUDIT_LLM_MAX_TOKENS=3000
# Older compatible endpoints may require max_tokens.
AUDIT_LLM_TOKEN_PARAMETER=max_completion_tokens
AUDIT_LLM_TIMEOUT=120
# A limit on requests, not a USD budget. Each site/page/pair is one request.
AUDIT_LLM_MAX_REQUESTS=20

# Optional. Only used when collect --pagespeed is explicitly requested.
PAGESPEED_API_KEY=
